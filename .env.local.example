# APIキー（サーバ側でのみ使用）
#
# 1) このファイルを .env.local にコピーする
# 2) 使う方のキーに値を入れる。.env.local は .gitignore 済みでコミットされない
# 3) Vercel では、同じ変数をダッシュボードの Environment Variables に登録する
#
# NEXT_PUBLIC_ を付けないこと。付けるとブラウザに露出する。


# --- 第一候補：Google AI Studio（無料・カード登録不要） ---
#
# https://aistudio.google.com/ に Google アカウントでログインし
# 「Get API key」を押すだけで即時発行される。費用0円。
# 無料枠は 15 リクエスト/分、1,500 リクエスト/日。
#
# 注意：無料枠の入力データは Google のサービス改善に使われうる。
#       デモには架空の状態テキストのみを入れること。
#
# 値を引用符で囲まないこと（GOOGLE_API_KEY=AQ... と直接書く）。
# 囲むと npm run try 側が引用符ごとキーとして送ってしまい、
# 「アプリでは通るのに try だけ 400 API_KEY_INVALID」になる。
GOOGLE_API_KEY=

# 使用モデルの上書き（省略時は lib/llm.ts の既定値）。
# preview 版が提供終了したときは、ここで差し替えて復旧できる。
# GOOGLE_GEMINI_MODEL=gemini-3-flash-preview


# --- 需要データの封緘鍵（サーバ側でのみ使用） ---
#
# 受け手の Needs はサーバがこの鍵で暗号化し、受け手の端末が封緘した状態で持つ。
# 譲る側の端末は封緘されたまま受け取り、サーバに渡して Handoff を生成する。
# 譲る側の端末は Needs の中身を一度も復号できない（AGENTS.md §3）。
# サーバは状態を持たないので、Vercel のサーバレスでもインスタンス間の食い違いが起きない。
#
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未設定の場合は開発用の固定鍵で動く（ログに警告が出る）。公開環境では必ず設定すること。
SOTTO_BLOB_KEY=
